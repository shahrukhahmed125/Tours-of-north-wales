# Boutique Tours of North Wales server settings (Apache / cPanel / LiteSpeed)
# Generated by kit.js from site.json and <docs>/templates/htaccess. Edit those, not this file.

# Show the branded "page not found" page for missing addresses
ErrorDocument 404 /404.html

# Don't list folder contents
Options -Indexes

# Send every visitor to the secure https:// address
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# Compress text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# Basic security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Keep private files private
<FilesMatch "\.(md|json|log|sh|bak)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
<Files "site.webmanifest">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</Files>

# Old WordPress addresses → new pages (keeps search rankings and old links working)
<IfModule mod_alias.c>
  Redirect 301 /about-us/ /about.html
  Redirect 301 /north-wales-tours/ /tours.html
  Redirect 301 /north-wales-multi-tour/ /tour-and-stay.html
  Redirect 301 /2-day-highlights-of-north-wales-tour/ /tour-and-stay-2-day.html
  Redirect 301 /2-day-highlights-of-north-wales-tour-2/ /tour-and-stay-2-day.html
  Redirect 301 /3-day-a-taste-of-north-wales/ /tour-and-stay-3-day.html
  Redirect 301 /4-day-tour-discover-north-wales-tour/ /tour-and-stay-4-day.html
  Redirect 301 /holyhead-and-liverpool-cruise-tours/ /cruise-tours.html
  Redirect 301 /ancestral-genealogy-tours-north-wales/ /ancestral-tours.html
  Redirect 301 /contact-us/ /contact.html
  Redirect 301 /contact /contact.html
  Redirect 301 /enquiry/ /contact.html
  Redirect 301 /north-wales-accommodation/ /where-to-stay.html
  Redirect 301 /north-wales-hotels /where-to-stay.html#hotels
  Redirect 301 /country-house-hotels-north-wales/ /where-to-stay.html#country-houses
  Redirect 301 /pubs-inns-with-rooms-north-wales/ /where-to-stay.html#inns
  Redirect 301 /bed-breakfast-guesthouse-north-wales/ /where-to-stay.html#guesthouses
  Redirect 301 /accommodation-type/ /where-to-stay.html
  Redirect 301 /terms-and-conditions-of-booking/ /booking-terms.html
  Redirect 301 /website-conditions/ /terms.html
