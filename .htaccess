  Redirect 301 /5-reasons-to-choose-taking-a-private-tour/ /journal-5-reasons-private-tour.html
  Redirect 301 /football-stadium-tours/ /journal-football-stadium-tours.html
  Redirect 301 /boutique-tours-of-north-wales-awards/ /journal-tripadvisor-awards.html
  Redirect 301 /tour/north-wales-in-a-nutshell/ /tour-north-wales-in-a-nutshell.html
